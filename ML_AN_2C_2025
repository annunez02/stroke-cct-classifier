{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceId":11154087,"sourceType":"datasetVersion","datasetId":6925704}],"dockerImageVersionId":31154,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ====================== IMPORTS ======================\nimport os\nimport random\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader, Subset\nfrom torchvision import transforms\nfrom sklearn.metrics import classification_report, confusion_matrix, accuracy_score, precision_recall_curve, auc\nfrom sklearn.model_selection import train_test_split\nfrom PIL import Image\nfrom tqdm import tqdm\nimport cv2\n\n# ====================== CONFIG ======================\nBASE_PATH = '/kaggle/input/brain-stroke-ct-dataset/Brain_Stroke_CT_Dataset'\nBATCH_SIZE = 16  \nIMG_SIZE = 256   # High Def\nNUM_EPOCHS = 24\nLR = 1e-4\nNUM_WORKERS = 4\nSEED = 42\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nSAVE_DIR = '/kaggle/working'\nos.makedirs(SAVE_DIR, exist_ok=True)\n\n# Reproducibility\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\n\n\n# ====================== DATA AUGMENTATION ======================\n\ntrain_transform = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.RandomHorizontalFlip(),\n    transforms.RandomAffine(degrees=10, translate=(0.05, 0.05), scale=(0.95, 1.05)),\n    transforms.ToTensor(),\n    transforms.Normalize((0.5,), (0.5,))\n])\n\nval_transform = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize((0.5,), (0.5,))\n])\n\n# ====================== DATASET (RAW GRAYSCALE) ======================\nclass StandardCTDataset(Dataset):\n    # store file paths and labels.\n    def __init__(self, samples, labels, transform=None):\n        self.samples = samples\n        self.labels = labels\n        self.transform = transform\n\n    def __len__(self):\n        return len(self.samples)\n\n    #called when loader asks for a batch\n    def __getitem__(self, idx):\n        path = self.samples[idx]\n        img = Image.open(path).convert(\"L\") # Luminance (grayscale)\n        \n        if self.transform:\n            img = self.transform(img)\n        \n        filename = os.path.basename(path) # for visualization\n        return img, self.labels[idx], filename\n\n# list of file paths and numeric labels \ndef get_samples_labels(base_path, class_map): \n    samples, labels = [], []\n    \n    for cls, label_idx in class_map.items():\n        folder = os.path.join(base_path, cls, 'PNG')\n        if not os.path.exists(folder): continue\n        \n        for f in os.listdir(folder):\n            if f.lower().endswith('.png'):\n                samples.append(os.path.join(folder, f))\n                labels.append(label_idx)\n    \n    return samples, labels\n\n# split data into train (80%) and val(20%) - train_test_split\ndef make_loaders(base_path, classes_dict, val_split=0.2):\n    samples, labels = get_samples_labels(base_path, classes_dict)\n    \n    train_idx, val_idx = train_test_split(\n        np.arange(len(labels)), test_size=val_split, \n        stratify=labels, random_state=SEED, shuffle=True\n    )\n    \n    # Create Subsets manually to pass to custom Dataset\n    train_ds = StandardCTDataset([samples[i] for i in train_idx], [labels[i] for i in train_idx], transform=train_transform)\n    val_ds = StandardCTDataset([samples[i] for i in val_idx], [labels[i] for i in val_idx], transform=val_transform)\n    \n    train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=NUM_WORKERS, pin_memory=True)\n    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=True)\n    return train_loader, val_loader\n\n# ====================== HIGH-DEF MODEL ======================\n\n# modifico el layer del transformer para que me devuelva weights que necesito para la visualizacion\nclass WeightsEnabledEncoderLayer(nn.TransformerEncoderLayer):\n    def _sa_block(self, x, attn_mask, key_padding_mask, is_causal=False):\n        x, weights = self.self_attn(\n            x, x, x, attn_mask=attn_mask, \n            key_padding_mask=key_padding_mask, \n            need_weights=True, # ensures the attention map is calculated and returned\n            is_causal=is_causal\n        )\n        return self.dropout1(x)\n\n\n# Una imagen 256x256 flattened es 65,536 pixeles, demasiado grande para un transformer, con capas conv paso de 256 - 128 - 64 a 32 \n# Entonces el transformer usa 32×32=1024 tokens, que es mas eficiente\nclass CompactConvTransformer(nn.Module):\n    def __init__(self, num_classes=2, img_size=256, in_channels=1, emb_dim=64, n_heads=4, depth=2):\n        super().__init__()\n        \n        # Conv Stem with MaxPool for 256 -> 32 reduction\n        self.conv_stem = nn.Sequential(\n            nn.Conv2d(in_channels, 32, 3, stride=2, padding=1),\n            nn.ReLU(),\n            nn.Conv2d(32, 64, 3, stride=2, padding=1),\n            nn.ReLU(),\n            nn.MaxPool2d(kernel_size=2, stride=2), \n            nn.Dropout(0.1)\n        )\n        \n        reduced = img_size // 8 \n        self.seq_len = reduced * reduced + 1\n        \n        self.embedding = nn.Linear(64, emb_dim) # proyecta  CNN features a un vector size of 64\n        self.cls_token = nn.Parameter(torch.randn(1, 1, emb_dim)) # model aggregates all information into this single token to make the final classification decision\n        self.pos_embedding = nn.Parameter(torch.randn(1, self.seq_len, emb_dim)) # information about where each patch is in the image\n        # los transformers no \"saben\" up/down/left/right\n        \n        # Transformer layers (Self-Attention) that learn global relationships between different parts of the brain scan\n        encoder_layer = WeightsEnabledEncoderLayer(d_model=emb_dim, nhead=n_heads, dim_feedforward=128, dropout=0.1, batch_first=True)\n        self.encoder = nn.TransformerEncoder(encoder_layer, num_layers=depth)\n        \n        self.norm = nn.LayerNorm(emb_dim)\n        self.head = nn.Linear(emb_dim, num_classes) #final Linear layer\n\n    def forward(self, x):\n        x = self.conv_stem(x)\n        x = x.flatten(2).transpose(1, 2)\n        x = self.embedding(x)\n        \n        cls_tokens = self.cls_token.expand(x.shape[0], -1, -1)\n        x = torch.cat((cls_tokens, x), dim=1)\n        x = x + self.pos_embedding\n        x = self.encoder(x)\n        \n        x = x[:, 0]\n        x = self.norm(x)\n        return self.head(x)\n\n        \n# ====================== TRAINING UTILS ======================\n\ndef train_epoch(model, loader, opt, crit, scaler):\n    model.train()\n    total_loss = 0\n    correct = 0\n    total_samples = 0\n    \n    for img, lab, _ in tqdm(loader, desc=\"Train\", leave=False):\n        img, lab = img.to(DEVICE), lab.to(DEVICE)\n        opt.zero_grad(set_to_none=True)\n        \n        # Mixed Precision (float16) to speed up training and reduce memory usage on the GPU\n        with torch.amp.autocast('cuda', enabled=(DEVICE.type=='cuda')):\n            logits = model(img)\n            loss = crit(logits, lab)\n        \n        scaler.scale(loss).backward()\n        scaler.step(opt)\n        scaler.update()\n        \n        # Calculate Metrics\n        total_loss += loss.item() * img.size(0)\n        preds = logits.argmax(dim=1)\n        correct += (preds == lab).sum().item()\n        total_samples += lab.size(0)\n    \n    avg_loss = total_loss / len(loader.dataset)\n    acc = correct / total_samples\n    \n    return avg_loss, acc\n\ndef validate(model, loader, crit):\n    model.eval()\n    total_loss = 0\n    preds, trues, probs = [], [], []\n    \n    with torch.no_grad():\n    \n        for img, lab, _ in loader:\n            img, lab = img.to(DEVICE), lab.to(DEVICE)\n            logits = model(img)\n            loss = crit(logits, lab)\n            total_loss += loss.item() * img.size(0)\n            preds.extend(logits.argmax(1).cpu().numpy())\n            trues.extend(lab.cpu().numpy())\n            probs.extend(torch.softmax(logits, 1).cpu().numpy())\n    \n    return total_loss / len(loader.dataset), np.array(trues), np.array(preds), np.array(probs)\n\ndef run_training(model_name, classes_map):\n    print(f\"\\n--- Training {model_name} (High Def 256) ---\")\n    train_loader, val_loader = make_loaders(BASE_PATH, classes_map)\n    \n    # Class Weights, calcula pesos para balancear loss\n    train_labels = train_loader.dataset.labels\n    counts = np.bincount(train_labels)\n    weights = torch.tensor([sum(counts)/(2*c) for c in counts], dtype=torch.float).to(DEVICE)\n    print(f\"Class Weights: {weights.cpu().numpy()}\")\n    \n    model = CompactConvTransformer(num_classes=2, img_size=IMG_SIZE, in_channels=1, emb_dim=64).to(DEVICE)\n    opt = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=1e-3) # Adam with Weight Decay, standard transformers\n    crit = nn.CrossEntropyLoss(weight=weights, label_smoothing=0.1) # avoid overfitting\n    scaler = torch.amp.GradScaler('cuda', enabled=(DEVICE.type=='cuda'))\n    \n    best_loss = float('inf')\n    \n    # === METRICS HISTORY STORAGE ===\n    history = {'train_loss': [], 'train_acc': [], 'val_loss': [], 'val_acc': []}\n\n    for epoch in range(NUM_EPOCHS):\n        tl, ta = train_epoch(model, train_loader, opt, crit, scaler) # NOW returns accuracy too\n        vl, yt, yp, _ = validate(model, val_loader, crit)\n        va = accuracy_score(yt, yp)\n        \n        print(f\"Ep {epoch+1}: Train Loss {tl:.4f} | Train Acc {ta:.4f} | Val Loss {vl:.4f} | Val Acc {va:.4f}\")\n    \n        # Store metrics\n        history['train_loss'].append(tl)\n        history['train_acc'].append(ta)\n        history['val_loss'].append(vl)\n        history['val_acc'].append(va)\n\n        if vl < best_loss:\n            best_loss = vl\n            torch.save(model.state_dict(), os.path.join(SAVE_DIR, f\"{model_name}.pt\"))\n    \n    # === PLOT TRAINING HISTORY ===\n    plt.figure(figsize=(12, 5))\n    \n    # Plot Loss\n    plt.subplot(1, 2, 1)\n    plt.plot(history['train_loss'], label='Train Loss')\n    plt.plot(history['val_loss'], label='Val Loss')\n    plt.title(f'{model_name} Loss History')\n    plt.xlabel('Epochs')\n    plt.ylabel('Loss')\n    plt.legend()\n    \n    # Plot Accuracy\n    plt.subplot(1, 2, 2)\n    plt.plot(history['train_acc'], label='Train Accuracy', color='blue')\n    plt.plot(history['val_acc'], label='Val Accuracy', color='green')\n    plt.title(f'{model_name} Accuracy History')\n    plt.xlabel('Epochs')\n    plt.ylabel('Accuracy')\n    plt.legend()\n    \n    plt.show()\n    \n    return model, val_loader\n\n# ====================== EXPLANABILITY ======================\n# Gradient-weighted Class Activation Mapping, para ver que regiones eran las mas activas en la ultima conv layer en la prediccion\nclass GradCAM: \n    def __init__(self, model, target_layer):\n        self.model = model\n        self.gradients = None\n        self.activations = None\n        target_layer.register_forward_hook(self.save_activation)\n        target_layer.register_full_backward_hook(self.save_gradient)\n\n    def save_activation(self, module, input, output): self.activations = output.detach()\n    def save_gradient(self, module, grad_input, grad_output): self.gradients = grad_output[0].detach()\n\n    def __call__(self, x):\n        self.model.zero_grad()\n        logits = self.model(x)\n        class_idx = logits.argmax(dim=1).item()\n        loss = logits[0, class_idx]\n        loss.backward(retain_graph=True)\n        \n        weights = self.gradients.mean(dim=(2,3), keepdim=True)\n        cam = (weights * self.activations).sum(dim=1, keepdim=True)\n        cam = torch.relu(cam).squeeze().cpu().numpy()\n        cam = (cam - cam.min()) / (cam.max() - cam.min() + 1e-8)\n        return cam, logits, torch.softmax(logits, dim=1)\n\nclass AttentionExtractor:\n    def __init__(self, model):\n        self.model = model\n        self.attns = []\n        for layer in self.model.encoder.layers:\n            layer.self_attn.register_forward_hook(self.capture)\n    def capture(self, module, inp, out):\n        if isinstance(out, tuple) and out[1] is not None: self.attns.append(out[1].detach().cpu())\n    def __call__(self, x):\n        self.attns = []\n        _ = self.model(x)\n        return self.attns\n\ndef compute_rollout(attns):\n    if not attns: return None\n    result = None\n    for attn in attns:\n        a = attn[0].mean(dim=0) # Batch 0, Mean Heads\n        a = a + torch.eye(a.shape[0])\n        a = a / a.sum(dim=-1, keepdim=True)\n        if result is None: result = a\n        else: result = torch.matmul(a, result)\n    return result[0, 1:] # CLS row\n\n# ====================== EVALUATION PLOTS ======================\n\ndef evaluate_performance(model, loader, model_name, class_names, threshold=None):\n    model.load_state_dict(torch.load(os.path.join(SAVE_DIR, f\"{model_name}.pt\")))\n    model.eval()\n    \n    _, y_true, y_pred, y_prob = validate(model, loader, nn.CrossEntropyLoss())\n    \n    if threshold:\n        print(f\"\\n[INFO] Applying {threshold*100}% Confidence Threshold for Class 0\")\n        y_pred = []\n        for p in y_prob:\n            y_pred.append(0 if p[0] > threshold else 1)\n        y_pred = np.array(y_pred)\n\n    print(f\"\\n=== {model_name} REPORT ===\")\n    print(classification_report(y_true, y_pred, target_names=class_names))\n    \n    # Confusion Matrix\n    cm = confusion_matrix(y_true, y_pred)\n    plt.figure(figsize=(5,4))\n    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=class_names, yticklabels=class_names)\n    plt.title(f\"{model_name} Confusion Matrix\")\n    plt.show()\n    \n    # PR Curve\n    precision, recall, _ = precision_recall_curve(y_true, y_prob[:, 1])\n    pr_auc = auc(recall, precision)\n    plt.figure(figsize=(6,4))\n    plt.plot(recall, precision, label=f'AUC = {pr_auc:.2f}')\n    plt.xlabel('Recall')\n    plt.ylabel('Precision')\n    plt.title(f\"{model_name} PR Curve (Class: {class_names[1]})\")\n    plt.legend()\n    plt.grid(True, alpha=0.3)\n    plt.show()\n\n# ====================== VISUALIZATION FUNCTION ======================\n\ndef visualize_hd(model_A, model_B, loader):\n    model_A.eval(); model_B.eval()\n    \n    cam_A = GradCAM(model_A, model_A.conv_stem[-2]) \n    att_ext_A = AttentionExtractor(model_A)\n    \n    cam_B = GradCAM(model_B, model_B.conv_stem[-2])\n    att_ext_B = AttentionExtractor(model_B)\n    \n    val_iter = iter(loader)\n    print(\"\\nVisualizing High-Def Predictions...\")\n    \n    for _ in range(5):\n        try: img, label, fname = next(val_iter)\n        except: break\n        \n        img_tensor = img[0].unsqueeze(0).to(DEVICE)\n        gt = label[0].item()\n        \n        # --- Stage A ---\n        cam_map_A, logits_A, probs_A = cam_A(img_tensor)\n        prob_normal = probs_A[0, 0].item()\n        \n        if prob_normal > 0.70: \n            stage = \"A\"\n            pred_desc = \"Normal\"\n            cam_map = cam_map_A\n            attns = att_ext_A(img_tensor)\n        else:\n            # --- Stage B ---\n            stage = \"B\"\n            cam_map_B, logits_B, probs_B = cam_B(img_tensor)\n            pred_b = logits_B.argmax(1).item()\n            cond = \"Bleeding\" if pred_b == 0 else \"Ischemia\"\n            pred_desc = f\"Abnormal ({cond})\"\n            cam_map = cam_map_B\n            attns = att_ext_B(img_tensor)\n\n        # Attention Map\n        rollout = compute_rollout(attns)\n        if rollout is not None:\n            # Reshape 1024 -> 32x32 (since 256/8 = 32)\n            attn_map = rollout.view(32, 32).numpy()\n            attn_map = cv2.resize(attn_map, (IMG_SIZE, IMG_SIZE))\n            attn_map = (attn_map - attn_map.min()) / (attn_map.max() - attn_map.min() + 1e-8)\n        else:\n            attn_map = np.zeros((IMG_SIZE, IMG_SIZE))\n            \n        cam_map = cv2.resize(cam_map, (IMG_SIZE, IMG_SIZE))\n        \n       \n        disp_img = img_tensor.cpu().squeeze().numpy()\n        # Percentile norm to fix contrast\n        p1, p99 = np.percentile(disp_img, 1), np.percentile(disp_img, 99)\n        disp_img = np.clip((disp_img - p1) / (p99 - p1 + 1e-8), 0, 1)\n\n        # True Label Logic\n        if gt == 0: true_desc = \"Normal\"\n        else:\n            # Need to cheat slightly to know specific condition for ground truth \n            # (In real app we wouldn't know, but for vis we want to check)\n            # We assume label 1 in loader_A covers both bleeding/ischemia\n            true_desc = \"Abnormal\" \n\n        print(f\"File: {fname[0]}\")\n        print(f\"True: {true_desc} | Pred: {pred_desc} | Prob Normal: {prob_normal:.2f}\")\n        \n        plt.figure(figsize=(10, 3))\n        plt.subplot(1,3,1); plt.title(\"HD Input (Contrast Enhanced)\"); plt.imshow(disp_img, cmap='gray'); plt.axis('off')\n        plt.subplot(1,3,2); plt.title(\"Grad-CAM\"); plt.imshow(disp_img, cmap='gray'); plt.imshow(cam_map, cmap='jet', alpha=0.5); plt.axis('off')\n        plt.subplot(1,3,3); plt.title(\"Attention\"); plt.imshow(disp_img, cmap='gray'); plt.imshow(attn_map, cmap='jet', alpha=0.5); plt.axis('off')\n        plt.show()\n\n# ====================== EXECUTION ======================\n\n# 1. Train\nmodel_A, loader_A = run_training('Model_A_HD', {'Normal': 0, 'Bleeding': 1, 'Ischemia': 1})\nevaluate_performance(model_A, loader_A, 'Model_A_HD', ['Normal', 'Unnormal'], threshold=0.70)\n\nmodel_B, loader_B = run_training('Model_B_HD', {'Bleeding': 0, 'Ischemia': 1})\nevaluate_performance(model_B, loader_B, 'Model_B_HD', ['Bleeding', 'Ischemia'])\n\n# 2. Visualize\nvisualize_hd(model_A, model_B, loader_A)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-16T22:23:02.773623Z","iopub.execute_input":"2025-12-16T22:23:02.773948Z","iopub.status.idle":"2025-12-16T22:39:25.108733Z","shell.execute_reply.started":"2025-12-16T22:23:02.773920Z","shell.execute_reply":"2025-12-16T22:39:25.107792Z"}},"outputs":[{"name":"stdout","text":"\n--- Training Model_A_HD (High Def 256) ---\nClass Weights: [0.7509881 1.496063 ]\n","output_type":"stream"},{"name":"stderr","text":"                                                        \r","output_type":"stream"},{"name":"stdout","text":"Ep 1: Train Loss 0.7178 | Train Acc 0.4977 | Val Loss 0.7044 | Val Acc 0.3346\n","output_type":"stream"},{"name":"stderr","text":"                                                        \r","output_type":"stream"},{"name":"stdout","text":"Ep 2: Train Loss 0.6971 | Train Acc 0.5303 | Val Loss 0.6731 | Val Acc 0.5887\n","output_type":"stream"},{"name":"stderr","text":"                                                        \r","output_type":"stream"},{"name":"stdout","text":"Ep 3: Train Loss 0.6635 | Train Acc 0.6199 | Val Loss 0.6479 | Val Acc 0.6707\n","output_type":"stream"},{"name":"stderr","text":"                                                        \r","output_type":"stream"},{"name":"stdout","text":"Ep 4: Train Loss 0.6497 | Train Acc 0.6320 | Val Loss 0.6383 | Val Acc 0.6368\n","output_type":"stream"},{"name":"stderr","text":"                                                        \r","output_type":"stream"},{"name":"stdout","text":"Ep 5: Train Loss 0.6439 | Train Acc 0.6342 | Val Loss 0.6345 | Val Acc 0.6323\n","output_type":"stream"},{"nam